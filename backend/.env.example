# Copy to backend/.env and fill in. Never commit backend/.env.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required for live routing + geocoding (free key: https://developer.tomtom.com)
TOMTOM_API_KEY=
# Override only to point at a mock server
TOMTOM_BASE_URL=https://api.tomtom.com

# Weather (free tier needs no key). Set OPEN_METEO_API_KEY to use the commercial host.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# Optional shared cache; LocMem is used when unset
REDIS_URL=

# 1 = serve TomTom / Open-Meteo from recorded fixtures (no keys, no quota). Dev/CI only:
# the fixtures live in trips/tests/fixtures, which the Docker image excludes.
# Pick a scenario per request with the X-Fixture header (see the api-contracts skill).
PLAN_FIXTURES=0

GIT_SHA=dev
